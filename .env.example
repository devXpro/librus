# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here

# MongoDB Configuration
MONGO_EXPRESS_PASSWORD=your_secure_password_here

# Translation Services (Optional)
OPEN_AI_KEY=your_openai_api_key_here

# Proxy Configuration (Optional)
HTTP_PROXY_HOST=
HTTP_PROXY_PORT=
HTTP_PROXY_USER=
HTTP_PROXY_PASSWORD=

# Development/Debug Settings
LOG_LEVEL=INFO

# Message Processing Configuration
MESSAGE_CHECK_INTERVAL=30m

# gRPC Configuration (Optional - uses defaults if not set)
GRPC_SCRAPER_ADDRESS=librus-scraper:50051

# Attachments Configuration (Optional - uses defaults if not set)
ATTACHMENTS_BASE_DIR=/app/attachments
