{
  "name": "librus-scraper",
  "version": "1.0.0",
  "description": "Librus scraper service using Playwright",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "DEVELOPMENT=true LOG_LEVEL=DEBUG ts-node src/server.ts",
    "dev:headless": "DEVELOPMENT=false LOG_LEVEL=DEBUG ts-node src/server.ts",
    "test": "jest",
    "proto:generate": "grpc_tools_node_protoc --plugin=node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/generated --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,esModuleInterop=true --descriptor_set_out=./protoset.bin --include_imports --proto_path=../proto ../proto/librus_scraper.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.2",
    "axios": "^1.11.0",
    "dotenv": "^16.4.7",
    "long": "^5.2.3",
    "nice-grpc": "^2.1.9",
    "nice-grpc-server-reflection": "^3.0.1",
    "playwright": "^1.49.0",
    "protobufjs": "^7.4.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "grpc-tools": "^1.12.4",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.4.0",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "librus",
    "scraper",
    "playwright",
    "grpc"
  ],
  "author": "",
  "license": "MIT"
}
